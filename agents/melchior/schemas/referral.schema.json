{
  "title": "Melchior.Magi answer to one fact-layer referral by Caspar.Magi (design 22.9.8; plan 9, Task 17)",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "claim_index", "quote", "figures", "correct", "reason", "source_date"],
  "properties": {
    "verdict": {"enum": ["upheld", "rejected", "needs_assist"]},
    "claim_index": {"type": ["integer", "null"], "minimum": 0},
    "quote": {"type": ["string", "null"]},
    "figures": {"type": "array", "items": {"$ref": "#/$defs/figure"}},
    "correct": {
      "anyOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["text", "figures"],
         "properties": {"text": {"type": "string"}, "figures": {"type": "array", "items": {"$ref": "#/$defs/figure"}}}}
      ]
    },
    "reason": {"type": "string", "maxLength": 1000},
    "source_date": {
      "anyOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["quote", "date"],
         "properties": {"quote": {"type": "string"}, "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}}}
      ]
    }
  },
  "$defs": {
    "figure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "source", "unit"],
      "properties": {"claim": {"type": "string"}, "source": {"type": "string"}, "unit": {"type": ["string", "null"]}}
    }
  }
}
