{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "protocol/benchmarks/v<version>.yaml (a version in force is never edited; a change is a new version file)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "effective_from", "markets", "benchmarks", "series"],
  "properties": {
    "schema": {"const": "magi/benchmark-policy@1"},
    "version": {"type": "integer", "minimum": 1},
    "effective_from": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "markets": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["market", "provider", "suffixes"],
        "properties": {
          "market": {"$ref": "#/$defs/market"},
          "provider": {"enum": ["yahoo", "naver"]},
          "suffixes": {"type": "array", "minItems": 1, "uniqueItems": true,
                       "items": {"type": "string", "pattern": "^(\\.[A-Z0-9]{1,4})?$"}}
        }
      }
    },
    "benchmarks": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["asset_types", "market", "benchmark"],
        "properties": {
          "asset_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "market": {"anyOf": [{"$ref": "#/$defs/market"}, {"const": "any"}]},
          "benchmark": {"$ref": "#/$defs/asset_id"}
        }
      }
    },
    "series": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/asset_id"},
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["role", "name", "type", "sector", "currency", "price_source"],
        "properties": {
          "role": {"enum": ["benchmark", "market-state"]},
          "name": {"type": "string"},
          "type": {"type": "string"},
          "sector": {"type": "string"},
          "currency": {"type": "string"},
          "price_source": {"type": "object"}
        }
      }
    }
  },
  "$defs": {
    "market": {"type": "string", "pattern": "^[A-Z]{2,8}$"},
    "asset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"}
  }
}
