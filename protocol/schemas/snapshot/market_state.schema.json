{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "snapshot market_state.json: the market-state series (protocol section 10)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "as_of",
    "series",
    "spreads"
  ],
  "properties": {
    "as_of": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      ]
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spy",
        "1306-t",
        "btc-usd",
        "xlf",
        "dbc"
      ],
      "properties": {
        "spy": {
          "$ref": "#/$defs/series"
        },
        "1306-t": {
          "$ref": "#/$defs/series"
        },
        "btc-usd": {
          "$ref": "#/$defs/series"
        },
        "xlf": {
          "$ref": "#/$defs/series"
        },
        "dbc": {
          "$ref": "#/$defs/series"
        }
      }
    },
    "spreads": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value_minus_growth",
        "small_minus_large"
      ],
      "properties": {
        "value_minus_growth": {
          "$ref": "#/$defs/spread"
        },
        "small_minus_large": {
          "$ref": "#/$defs/spread"
        }
      }
    }
  },
  "$defs": {
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registered",
        "closes",
        "total_return_3m",
        "total_return_12m",
        "deviation_200d",
        "volatility_20d",
        "volatility_percentile_3y"
      ],
      "properties": {
        "registered": {
          "type": "boolean"
        },
        "closes": {
          "type": "integer",
          "minimum": 0
        },
        "total_return_3m": {
          "type": [
            "number",
            "null"
          ]
        },
        "total_return_12m": {
          "type": [
            "number",
            "null"
          ]
        },
        "deviation_200d": {
          "type": [
            "number",
            "null"
          ]
        },
        "volatility_20d": {
          "type": [
            "number",
            "null"
          ]
        },
        "volatility_percentile_3y": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "spread": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "3m",
        "12m"
      ],
      "properties": {
        "3m": {
          "type": [
            "number",
            "null"
          ]
        },
        "12m": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    }
  }
}
