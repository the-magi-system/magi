{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "snapshot forecasts.json: forecast scores by group and actor (protocol section 8)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "valuation_date",
    "rules",
    "groups",
    "actors"
  ],
  "properties": {
    "valuation_date": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      ]
    },
    "rules": {
      "type": "array",
      "items": {
        "enum": [
          "crps-rel@1"
        ]
      }
    },
    "groups": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(1-3|4-12|13-36|37-120)/(equity|fund-index|crypto|other)$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/group"
      }
    },
    "actors": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "owner",
          "all"
        ],
        "properties": {
          "owner": {
            "type": "string"
          },
          "all": {
            "$ref": "#/$defs/stats"
          }
        }
      }
    }
  },
  "$defs": {
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "counted_settled",
        "not_counted",
        "mean_crps_rel",
        "median_crps_rel",
        "due",
        "settled",
        "unsettled",
        "provisional",
        "pending",
        "not_due",
        "assets",
        "ideas",
        "uncertainty",
        "calibration"
      ],
      "properties": {
        "owner": {
          "type": "string"
        },
        "counted_settled": {
          "type": "integer",
          "minimum": 0
        },
        "not_counted": {
          "type": "integer",
          "minimum": 0
        },
        "mean_crps_rel": {
          "type": [
            "number",
            "null"
          ]
        },
        "median_crps_rel": {
          "type": [
            "number",
            "null"
          ]
        },
        "due": {
          "type": "integer",
          "minimum": 0
        },
        "settled": {
          "type": "integer",
          "minimum": 0
        },
        "unsettled": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "no_quote",
              "halted",
              "delisted",
              "acquired",
              "other"
            ]
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "provisional": {
          "type": "integer",
          "minimum": 0
        },
        "pending": {
          "type": "integer",
          "minimum": 0
        },
        "not_due": {
          "type": "integer",
          "minimum": 0
        },
        "assets": {
          "type": "integer",
          "minimum": 0
        },
        "ideas": {
          "type": "integer",
          "minimum": 0
        },
        "uncertainty": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "se",
                "low",
                "high"
              ],
              "properties": {
                "se": {
                  "type": "number",
                  "minimum": 0
                },
                "low": {
                  "type": "number"
                },
                "high": {
                  "type": "number"
                }
              }
            }
          ]
        },
        "calibration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "below_p10",
            "above_p90",
            "within_p10_p90",
            "pit_mean",
            "too_few"
          ],
          "properties": {
            "below_p10": {
              "type": "integer",
              "minimum": 0
            },
            "above_p90": {
              "type": "integer",
              "minimum": 0
            },
            "within_p10_p90": {
              "type": "integer",
              "minimum": 0
            },
            "pit_mean": {
              "type": [
                "number",
                "null"
              ]
            },
            "too_few": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actors",
        "all",
        "ranking"
      ],
      "properties": {
        "actors": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/stats"
          }
        },
        "all": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "owners",
            "mean_crps_rel"
          ],
          "properties": {
            "owners": {
              "type": "integer",
              "minimum": 0
            },
            "mean_crps_rel": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "ranking": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ranked",
            "too_few"
          ],
          "properties": {
            "ranked": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "actor",
                  "mean_crps_rel",
                  "counted_settled",
                  "assets"
                ],
                "properties": {
                  "actor": {
                    "type": "string"
                  },
                  "mean_crps_rel": {
                    "type": "number"
                  },
                  "counted_settled": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "assets": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            },
            "too_few": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
