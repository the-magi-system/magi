{"seq": 117, "at": "2026-11-08T15:01:16Z", "issue": 156, "action": "update_view", "actor": "arc.cheng", "owner": "cheng", "entity": "ideas/ectm-us-finite-royalty-cash-recovery/views/arc.cheng", "version": 1, "target_date": "2029-11-08", "proposal_sha256": "cc682c636d96aaf6f6d967f5dc260875ed0a85169c106c6c51a7d8713a5f0240", "diff": {"position": [null, "neutral"], "strategy": [null, "owner-cash-realization"], "horizon_months": [null, 36], "target_date": [null, "2029-11-08"], "confidence": [null, 0.35], "methodology": [null, "arc-owner-earnings"], "non_public_pillars": [null, []], "derived.expected_price": [null, 0.39875], "derived.expected_return": [null, -0.113889], "derived.p10": [null, 0.155], "derived.p50": [null, 0.455], "derived.p90": [null, 0.63]}, "rationale": "以持有人有限日期现金流研究ECTM，在HH3.25固定名义价及约0.45美元报价下，原日期基准IRR约20.45%。2030权益减半后出售，固定费用、基差和运营商决定回收。采用neutral，等待Q3回款验证。 三年价格预测新增市场按15%要求回报给目标日剩余权益定价的假设；主观权重10/25/45/20并非统计概率。研究信心低，暂时standing aside。"}
